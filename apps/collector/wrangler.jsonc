{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "market-intelligence-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "durable_objects": {
    "bindings": [
      {
        "name": "LIQUIDATION_COLLECTOR",
        "class_name": "LiquidationCollector"
      }
    ]
  },
  "exports": {
    "LiquidationCollector": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "COLLECTOR_SYMBOLS": "BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT",
    "CORS_ORIGIN": "*"
  }
}
